{
  "name": "e-commerce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve:ssr": "node dist/e-commerce/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.1.4",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.4",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.2.18",
    "@angular/ssr": "^21.1.4",
    "@emailjs/browser": "^4.4.1",
    "@primeng/themes": "^21.0.4",
    "canvas-confetti": "^1.9.4",
    "file-saver": "^2.0.5",
    "gsap": "^3.14.2",
    "jszip": "^3.10.1",
    "ogl": "^1.0.11",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.18",
    "swiper": "^12.1.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.60.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.4.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
